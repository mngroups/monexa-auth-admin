# Backend base URL used by Server Actions (server-only, never exposed to the browser).
API_BASE_URL=http://localhost:9000
# Verbose request/response tracing in the apiClient (lib/session.ts).
API_CLIENT_DEBUG=false

# Sign-in mode: `credentials` (in-app form) or `sso` (redirect to monexa-auth).
AUTH_MODE=sso
# monexa-auth origin, for the "Ganti password" link (server-only).
AUTH_PORTAL_URL=http://localhost:9000
# Client org slug (one deployment = one client); the same value as the BE's AUTH_ORG_HINT.
# The login card shows that org's logo from monexa-auth.
AUTH_ORG_HINT=

# Feature flags — see docs/guides/feature-flags.md.
# Client flags: one JSON object, baked in at build time (public).
#   NEXT_PUBLIC_FEATURE_FLAGS={"exampleFlag":true}
NEXT_PUBLIC_FEATURE_FLAGS={}
# Server flags: one FEATURE_* variable each (runtime, private). `pnpm flag:new --scope server` adds them here.
